{
  "name": "edelson-orihuela-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{astro,js,mjs,ts}\" \"scripts/**/*.mjs\" \"*.{js,mjs}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "validate:external": "node scripts/validate-external-links.mjs",
    "validate:html": "html-validate \"dist/es/**/*.html\" \"dist/en/**/*.html\" \"dist/404.html\"",
    "quality": "pnpm lint && pnpm format:check && pnpm build && pnpm validate:content && pnpm validate:dist && pnpm validate:html"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "html-validate": "11.6.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
