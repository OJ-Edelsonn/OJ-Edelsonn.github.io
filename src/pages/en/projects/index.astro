---
import { getCollection } from 'astro:content';
import ProjectCatalog from '../../../components/ProjectCatalog.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const projects = (
  await getCollection('projects', ({ data }) => data.locale === 'en' && !data.draft)
).sort((a, b) => a.data.priority - b.data.priority);
---

<BaseLayout
  locale="en"
  routeKey="projects"
  title="Projects — Edelson Orihuela"
  description="Personal and academic projects in data, BI, processes, consulting, and systems."
>
  <ProjectCatalog locale="en" projects={projects} />
</BaseLayout>
