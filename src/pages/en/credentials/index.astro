---
import { getCollection } from 'astro:content';
import CredentialsPage from '../../../components/CredentialsPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const credentials = (
  await getCollection('credentials', ({ data }) => data.locale === 'en' && !data.draft)
).sort((a, b) => a.data.priority - b.data.priority);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Credentials of Edelson Anghuelo Orihuela Jara',
  numberOfItems: credentials.length,
  itemListElement: credentials.map((credential, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: credential.data.title,
    description: credential.data.summary,
  })),
};
---

<BaseLayout
  locale="en"
  routeKey="credentials"
  title="Credentials — Edelson Orihuela"
  description="Documented certificates, complementary learning, and academic achievements of Edelson Anghuelo Orihuela Jara."
  structuredData={structuredData}
>
  <CredentialsPage locale="en" credentials={credentials} />
</BaseLayout>
