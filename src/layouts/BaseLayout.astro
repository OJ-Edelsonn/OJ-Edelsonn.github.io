---
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SystemBackdrop from '../components/SystemBackdrop.astro';
import type { Locale } from '../config/site';
import { getAlternateLocale, getRoute, withBase, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  alternateHref?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale,
  routeKey,
  title,
  description,
  alternateHref,
  noindex = routeKey === 'notFound',
  structuredData,
} = Astro.props;
const t = useTranslations(locale);
const alternateLocale = getAlternateLocale(locale);
const localizedAlternateHref = withBase(alternateHref ?? getRoute(routeKey, alternateLocale));
const canonicalHref = Astro.url.pathname;
const xDefaultHref = locale === 'es' ? canonicalHref : localizedAlternateHref;
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      locale={locale}
      canonicalHref={canonicalHref}
      alternateHref={localizedAlternateHref}
      xDefaultHref={xDefaultHref}
      noindex={noindex}
      structuredData={structuredData}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <SystemBackdrop />
    <SiteHeader locale={locale} routeKey={routeKey} alternateHref={alternateHref} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
