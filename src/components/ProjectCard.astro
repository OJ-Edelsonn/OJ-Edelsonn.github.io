---
import type { Locale } from '../config/site';
import { withBase } from '../i18n/routes';
import {
  categoryLabel,
  natureLabel,
  projectHref,
  typeLabel,
  type ProjectEntry,
} from '../data/projects';

interface Props {
  project: ProjectEntry;
  locale: Locale;
  index: number;
  emphasis?: boolean;
  headingLevel?: 'h3' | 'h5';
}

const { project, locale, index, emphasis = false, headingLevel = 'h3' } = Astro.props;
const href = withBase(projectHref(project));
const signal = project.data.dataNature.find((item) => item === 'synthetic' || item === 'simulated');
const viewLabel = locale === 'es' ? 'Ver caso' : 'View case';
const Heading = headingLevel;
---

<article
  class:list={['project-card', { 'project-card--emphasis': emphasis }]}
  data-project-card
  data-category={project.data.category}
  data-project-kind={project.data.projectType}
  data-career-area={project.data.projectType === 'academic' ? project.data.careerArea : undefined}
>
  <a class="project-card__visual" href={href} aria-label={`${viewLabel}: ${project.data.title}`}>
    {
      project.data.coverImage && (
        <img
          src={withBase(project.data.coverImage)}
          alt=""
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      )
    }
    {
      !project.data.coverImage && (
        <span class="project-card__fallback" aria-hidden="true">
          <span>{project.data.projectId.slice(0, 3).toUpperCase()}</span>
          <>
            <i />
            <i />
            <i />
          </>
        </span>
      )
    }
    <span class="project-card__number">{String(index + 1).padStart(2, '0')}</span>
    {signal && <span class="project-card__signal">{natureLabel(signal, locale)}</span>}
  </a>
  <div class="project-card__body">
    <p class="project-card__meta">
      <span
        >{categoryLabel(project.data.category, locale)} · {
          typeLabel(project.data.projectType, locale)
        }</span
      >
      <span>{project.data.technologies.slice(0, 3).join(' / ')}</span>
    </p>
    <Heading class="project-card__title"><a href={href}>{project.data.title}</a></Heading>
    <p class="project-card__summary">{project.data.summary}</p>
    <div class="project-card__footer">
      <ul aria-label={locale === 'es' ? 'Tecnologías' : 'Technologies'}>
        {project.data.technologies.slice(0, 5).map((technology) => <li>{technology}</li>)}
      </ul>
      <a class="project-card__link" href={href}>{viewLabel}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 18px 55px rgba(0, 0, 0, 0.14);
    transition:
      transform var(--transition-base),
      border-color var(--transition-fast),
      box-shadow var(--transition-base);
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-line-strong);
    box-shadow: 0 24px 75px var(--color-glow);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card__visual {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-elevated);
    text-decoration: none;
  }

  .project-card__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(3, 7, 13, 0.78));
    pointer-events: none;
  }

  .project-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1),
      filter var(--transition-base);
  }

  .project-card__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      linear-gradient(90deg, transparent 49.8%, var(--color-line) 50%, transparent 50.2%),
      linear-gradient(transparent 49.8%, var(--color-line) 50%, transparent 50.2%),
      radial-gradient(circle at 50% 50%, var(--color-glow), transparent 46%);
    background-size:
      3.5rem 3.5rem,
      3.5rem 3.5rem,
      auto;
  }

  .project-card__fallback > span {
    position: relative;
    z-index: 1;
    display: grid;
    width: 7rem;
    place-items: center;
    aspect-ratio: 1;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    box-shadow:
      inset 0 0 2rem var(--color-glow),
      0 0 3rem var(--color-glow);
  }

  .project-card__fallback i {
    position: absolute;
    border: 1px solid var(--color-line);
    border-radius: 50%;
  }

  .project-card__fallback i:nth-of-type(1) {
    inset: 21%;
  }
  .project-card__fallback i:nth-of-type(2) {
    inset: 32%;
  }
  .project-card__fallback i:nth-of-type(3) {
    inset: 43%;
    border-color: var(--color-accent);
  }

  .project-card:hover .project-card__visual img {
    transform: scale(1.025);
  }

  .project-card__number,
  .project-card__signal {
    position: absolute;
    z-index: 1;
    bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__number {
    left: var(--space-4);
    color: var(--ink-000);
  }

  .project-card__signal {
    right: var(--space-4);
    padding: 0.3rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-sm);
    background: rgba(3, 7, 13, 0.76);
    color: var(--blue-100);
  }

  .project-card__body {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card__meta span:first-child {
    color: var(--color-accent-strong);
  }

  .project-card__title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-weight: 620;
  }

  .project-card__title a {
    text-decoration: none;
  }

  .project-card__summary {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
  }

  .project-card__footer {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.24rem 0.48rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .project-card__link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (min-width: 46rem) {
    .project-card--emphasis {
      grid-column: span 2;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    }

    .project-card--emphasis .project-card__visual {
      min-height: 100%;
      aspect-ratio: auto;
    }
  }
</style>
