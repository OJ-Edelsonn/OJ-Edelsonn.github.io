---
import type { Locale } from '../config/site';
import { SITE } from '../config/site';
import { getRoute, withBase } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy =
  locale === 'es'
    ? {
        code: 'CANAL / ABIERTO',
        title: 'Convirtamos una pregunta de negocio en un siguiente paso claro.',
        text: 'Busco oportunidades de prácticas preprofesionales en análisis de datos, BI, inteligencia comercial, consultoría y roles afines.',
        contact: 'Contactar',
        linkedin: 'Ver LinkedIn',
      }
    : {
        code: 'CHANNEL / OPEN',
        title: 'Let’s turn a business question into a clear next step.',
        text: 'I am seeking pre-professional internship opportunities in data analytics, BI, commercial intelligence, consulting, and related roles.',
        contact: 'Get in touch',
        linkedin: 'View LinkedIn',
      };
---

<section class="home-cta">
  <div class="container home-cta__panel">
    <p class="eyebrow">{copy.code}</p>
    <h2>{copy.title}</h2>
    <p class="home-cta__text">{copy.text}</p>
    <div class="home-cta__links">
      <a class="button button--primary" href={withBase(getRoute('contact', locale))}
        >{copy.contact}<span aria-hidden="true">↗</span></a
      >
      <a class="button button--secondary" href={SITE.linkedin} rel="me">{copy.linkedin}</a>
    </div>
  </div>
</section>

<style>
  .home-cta {
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  .home-cta__panel {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 7vw, 6rem);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, var(--color-glow), transparent 45%), var(--color-surface);
    box-shadow: var(--shadow-panel);
  }
  .home-cta__panel::after {
    content: 'EO';
    position: absolute;
    right: -0.05em;
    bottom: -0.34em;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(10rem, 30vw, 26rem);
    font-weight: 800;
    line-height: 1;
    -webkit-text-stroke: 1px var(--color-line);
    pointer-events: none;
  }
  h2 {
    position: relative;
    z-index: 1;
    max-width: 17ch;
    margin: 1rem 0;
    font-size: clamp(2.5rem, 6vw, 5.8rem);
  }
  .home-cta__text {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    color: var(--color-text-muted);
  }
  .home-cta__links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
