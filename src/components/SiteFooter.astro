---
import type { Locale } from '../config/site';
import { SITE } from '../config/site';
import { getRoute, withBase } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__signal">EO / PORTFOLIO SYSTEM</p>
      <p>{SITE.name}</p>
    </div>
    <p class="site-footer__note">{t.footerNote}</p>
    <div class="site-footer__links">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={SITE.github} rel="me">GitHub</a>
      <a href={SITE.linkedin} rel="me">LinkedIn</a>
      <a href={withBase(getRoute('credentials', locale))}>{t.credentials}</a>
      <a href={withBase(getRoute('contact', locale))}>{t.contact}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__signal {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .site-footer__note {
    color: var(--color-text-muted);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.25rem;
  }

  .site-footer__links a {
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .site-footer__links a:hover {
    color: var(--color-text);
  }

  @media (min-width: 52rem) {
    .site-footer__grid {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .site-footer__note {
      grid-column: 1;
    }

    .site-footer__links {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-content: flex-end;
    }
  }
</style>
