---
import type { Locale } from '../config/site';
import { SITE } from '../config/site';
import { getNavigation } from '../data/navigation';
import { getRoute, withBase, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  alternateHref?: string;
}

const { locale, routeKey, alternateHref } = Astro.props;
const navigation = getNavigation(locale);
const t = useTranslations(locale);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="identity" href={withBase(getRoute('home', locale))} aria-label={SITE.name}>
      <span class="identity__mark">EO</span>
      <span class="identity__copy">
        <strong>{SITE.shortName}</strong>
        <small>{t.systemLabel}</small>
      </span>
    </a>

    <nav
      class="desktop-nav"
      aria-label={`${t.navigation} — ${locale === 'es' ? 'escritorio' : 'desktop'}`}
    >
      {
        navigation.map((item, index) => (
          <a href={withBase(item.href)} aria-current={routeKey === item.key ? 'page' : undefined}>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__controls">
      <LanguageSwitcher locale={locale} routeKey={routeKey} alternateHref={alternateHref} />
      <ThemeToggle locale={locale} />
    </div>

    <div class="mobile-nav" data-mobile-nav>
      <button
        class="mobile-nav__toggle"
        type="button"
        aria-label={t.menu}
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-mobile-nav-toggle
      >
        <span></span><span></span>
      </button>
      <nav
        id="mobile-navigation"
        aria-label={`${t.navigation} — ${locale === 'es' ? 'móvil' : 'mobile'}`}
        data-mobile-nav-panel
        hidden
      >
        {
          navigation.map((item) => (
            <a href={withBase(item.href)} aria-current={routeKey === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        <div class="mobile-nav__controls">
          <LanguageSwitcher locale={locale} routeKey={routeKey} alternateHref={alternateHref} />
          <ThemeToggle locale={locale} />
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-mobile-nav]').forEach((mobileNav) => {
    const toggle = mobileNav.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
    const panel = mobileNav.querySelector<HTMLElement>('[data-mobile-nav-panel]');
    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    toggle.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      }
    });

    mobileNav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-background) 78%, transparent);
    backdrop-filter: blur(18px) saturate(135%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    min-height: var(--header-height);
    gap: var(--space-6);
  }

  .identity {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    text-decoration: none;
  }

  .identity__mark {
    display: grid;
    width: 2.55rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(145deg, var(--color-glow), transparent);
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    clip-path: polygon(0 0, 78% 0, 100% 22%, 100% 100%, 22% 100%, 0 78%);
  }

  .identity__copy {
    display: grid;
    line-height: 1.15;
  }

  .identity__copy strong {
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .identity__copy small {
    display: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .desktop-nav,
  .site-header__controls {
    display: none;
  }

  .desktop-nav a {
    display: grid;
    gap: 0.1rem;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .desktop-nav a span {
    color: var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .desktop-nav a[aria-current='page'] span {
    color: var(--color-accent-strong);
  }

  .mobile-nav {
    position: relative;
  }

  .mobile-nav__toggle {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    place-content: center;
    gap: 0.35rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .mobile-nav__toggle span {
    display: block;
    width: 1rem;
    height: 1px;
    background: var(--color-text);
    transition: transform var(--transition-fast);
  }

  .mobile-nav__toggle[aria-expanded='true'] span:first-child {
    transform: translateY(0.18rem) rotate(45deg);
  }

  .mobile-nav__toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-0.18rem) rotate(-45deg);
  }

  .mobile-nav nav {
    position: absolute;
    top: calc(100% + 0.7rem);
    right: 0;
    display: grid;
    width: min(18rem, calc(100vw - 2rem));
    padding: var(--space-3);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-panel);
  }

  .mobile-nav nav[hidden] {
    display: none;
  }

  .mobile-nav nav > a {
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-nav nav > a[aria-current='page'] {
    color: var(--color-accent-strong);
  }

  .mobile-nav__controls {
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  @media (min-width: 38rem) {
    .identity__copy small {
      display: block;
    }
  }

  @media (min-width: 67rem) {
    .desktop-nav,
    .site-header__controls {
      display: flex;
      align-items: center;
    }

    .desktop-nav {
      gap: clamp(0.8rem, 1.6vw, 1.65rem);
    }

    .site-header__controls {
      gap: var(--space-2);
    }

    .mobile-nav {
      display: none;
    }
  }
</style>
