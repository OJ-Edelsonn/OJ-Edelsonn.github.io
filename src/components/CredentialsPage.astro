---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config/site';
import { withBase } from '../i18n/routes';

interface Props {
  locale: Locale;
  credentials: CollectionEntry<'credentials'>[];
}

const { locale, credentials } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-PE' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const copy =
  locale === 'es'
    ? {
        eyebrow: 'Credenciales / evidencia documental',
        title: 'Formación complementaria, certificaciones y logros académicos.',
        intro:
          'Una selección de certificados, constancias y reconocimientos que documentan el desarrollo de mis competencias, la formación realizada fuera del plan de estudios y los principales hitos de mi trayectoria académica.',
        indexLabel: 'Índice de archivo',
        records: 'registros revisados',
        categories: 'categorías',
        privacyTitle: 'Presentación de documentos',
        privacyText:
          'Algunas vistas ocultan datos personales o identificadores que no son necesarios para presentar la credencial públicamente.',
        evidence: 'Documento',
        open: 'Ampliar documento',
        issued: 'Fecha registrada',
        period: 'Periodo',
        categoryIntro: 'Colección',
        admissionNote:
          'Estas constancias acreditan admisión en procesos específicos; no representan estudios culminados ni matrícula vigente.',
        gradesTitle: 'Notas académicas por curso',
        gradesIntro:
          'Calificaciones oficiales consolidadas para los cinco años de educación secundaria, en escala vigesimal.',
        subject: 'Curso',
        gradeContext:
          'Los años 2014–2015 corresponden a la institución de procedencia. Los años 2016–2018 corresponden al COAR Junín, institución de la que egresé.',
      }
    : {
        eyebrow: 'Credentials / documentary evidence',
        title: 'Complementary learning, certifications, and academic achievements.',
        intro:
          'A selection of certificates, records, and recognitions documenting the development of my skills, learning beyond the degree curriculum, and key milestones throughout my academic journey.',
        indexLabel: 'Archive index',
        records: 'reviewed records',
        categories: 'categories',
        privacyTitle: 'Document presentation',
        privacyText:
          'Some views conceal personal data or identifiers that are not necessary for presenting the credential publicly.',
        evidence: 'Document',
        open: 'Enlarge document',
        issued: 'Recorded date',
        period: 'Period',
        categoryIntro: 'Collection',
        admissionNote:
          'These records document admission in specific selection processes; they do not represent completed studies or current enrollment.',
        gradesTitle: 'Academic grades by subject',
        gradesIntro:
          'Official grades consolidated across the five years of secondary education, using Peru’s 20-point grading scale.',
        subject: 'Subject',
        gradeContext:
          'The 2014–2015 grades correspond to the previous school. The 2016–2018 grades correspond to COAR Junín, the school from which I graduated.',
      };

const categoryCopy =
  locale === 'es'
    ? {
        school: {
          code: 'EDU.01',
          title: 'Formación secundaria',
          description:
            'Mi educación secundaria abarcó de 2014 a 2018. El periodo cursado en el COAR Junín, institución de la que egresé, comprende los años 2016–2018.',
        },
        university: {
          code: 'EDU.02',
          title: 'Formación universitaria',
          description:
            'Programas y actividades complementarias desarrolladas durante la etapa universitaria.',
        },
        external: {
          code: 'TEC.03',
          title: 'Certificaciones externas',
          description:
            'Formación técnica validada por instituciones externas al programa universitario principal.',
        },
        achievement: {
          code: 'LOG.04',
          title: 'Logros y admisiones académicas',
          description:
            'Resultados documentados de procesos de admisión que forman parte de la trayectoria académica.',
        },
      }
    : {
        school: {
          code: 'EDU.01',
          title: 'Secondary education',
          description:
            'My secondary education covered 2014–2018. The period completed at COAR Junín, the school from which I graduated, spans 2016–2018.',
        },
        university: {
          code: 'EDU.02',
          title: 'University development',
          description:
            'Complementary programs and activities completed during the university stage.',
        },
        external: {
          code: 'TEC.03',
          title: 'External certifications',
          description:
            'Technical learning validated by institutions outside the primary university program.',
        },
        achievement: {
          code: 'ACH.04',
          title: 'Academic achievements and admissions',
          description:
            'Documented results from admission processes that form part of the academic journey.',
        },
      };

const categoryOrder = ['school', 'university', 'external', 'achievement'] as const;
---

<article class="credentials-page">
  <header class="credentials-hero">
    <div class="container credentials-hero__grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <div class="credentials-hero__summary">
        <p>{copy.intro}</p>
        <p class="sr-only">{copy.indexLabel}</p>
        <dl>
          <div>
            <dt>{credentials.length.toString().padStart(2, '0')}</dt><dd>{copy.records}</dd>
          </div>
          <div>
            <dt>{categoryOrder.length.toString().padStart(2, '0')}</dt><dd>{copy.categories}</dd>
          </div>
        </dl>
      </div>
    </div>
  </header>

  <aside class="container privacy-panel">
    <span aria-hidden="true">SEC / 01</span>
    <div><h2>{copy.privacyTitle}</h2><p>{copy.privacyText}</p></div>
  </aside>

  <div class="credential-collections">
    {
      categoryOrder.map((category, categoryIndex) => {
        const entries = credentials.filter((credential) => credential.data.category === category);
        const section = categoryCopy[category];

        return (
          <section class="credential-group" id={category} data-credential-category={category}>
            <div class="container credential-group__heading">
              <div>
                <p class="eyebrow">
                  {String(categoryIndex + 1).padStart(2, '0')} / {copy.categoryIntro}
                </p>
                <span>{section.code}</span>
              </div>
              <div>
                <h2>{section.title}</h2>
                <p>{section.description}</p>
                {category === 'achievement' && <p class="admission-note">{copy.admissionNote}</p>}
              </div>
            </div>

            <div class="container credential-grid">
              {entries.map((credential) => (
                <article class="credential-card" data-credential-card>
                  <a
                    class:list={[
                      'credential-card__preview',
                      {
                        'credential-card__preview--document': credential.data.grades.length > 0,
                      },
                    ]}
                    href={withBase(credential.data.previewImage)}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${copy.open}: ${credential.data.title}`}
                  >
                    <img
                      src={withBase(credential.data.previewImage)}
                      alt={credential.data.previewAlt}
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{copy.evidence}</span>
                  </a>
                  <div class="credential-card__body">
                    <div class="credential-card__meta">
                      <span>{credential.data.issuer}</span>
                      <time datetime={credential.data.date.toISOString()}>
                        {dateFormatter.format(credential.data.date)}
                      </time>
                    </div>
                    <h3>{credential.data.title}</h3>
                    <p>{credential.data.summary}</p>
                    <dl>
                      <div>
                        <dt>{copy.issued}</dt>
                        <dd>{dateFormatter.format(credential.data.date)}</dd>
                      </div>
                      {credential.data.period && (
                        <div>
                          <dt>{copy.period}</dt>
                          <dd>{credential.data.period}</dd>
                        </div>
                      )}
                    </dl>
                    <ul
                      aria-label={locale === 'es' ? 'Aspectos acreditados' : 'Documented aspects'}
                    >
                      {credential.data.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                    <p class="credential-card__privacy">{credential.data.privacyNote}</p>
                    <a
                      class="credential-card__link"
                      href={withBase(credential.data.previewImage)}
                      target="_blank"
                      rel="noopener"
                    >
                      {copy.open}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>

            {entries.map(
              (credential) =>
                credential.data.grades.length > 0 && (
                  <section class="container grades-panel" aria-labelledby="secondary-grades-title">
                    <div class="grades-panel__heading">
                      <div>
                        <p class="eyebrow">DATA / 01</p>
                        <h3 id="secondary-grades-title">{copy.gradesTitle}</h3>
                      </div>
                      <div>
                        <p>{copy.gradesIntro}</p>
                        <p class="grades-panel__context">{copy.gradeContext}</p>
                      </div>
                    </div>
                    <div class="grades-table-wrap">
                      <table data-grades-table>
                        <caption class="sr-only">{copy.gradesTitle}</caption>
                        <thead>
                          <tr>
                            <th scope="col">{copy.subject}</th>
                            {credential.data.gradeYears.map((year) => (
                              <th scope="col">{year}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {credential.data.grades.map((grade) => (
                            <tr data-grade-row>
                              <th scope="row">{grade.subject}</th>
                              {grade.scores.map((score) => (
                                <td>{score}</td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </section>
                ),
            )}
          </section>
        );
      })
    }
  </div>
</article>

<style>
  .credentials-hero {
    padding-block: clamp(5rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem);
  }

  .credentials-hero__grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  h1 {
    max-width: 14ch;
    margin: 1rem 0 0;
    font-size: clamp(3rem, 7.2vw, 6.8rem);
  }

  .credentials-hero__summary > p {
    max-width: 42rem;
    color: var(--color-text-muted);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .credentials-hero dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-8) 0 0;
  }

  .credentials-hero dl div {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line-strong);
  }

  .credentials-hero dt {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 4vw, 2.7rem);
    line-height: 1;
  }

  .credentials-hero dd {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .privacy-panel {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(125deg, var(--color-glow), transparent 58%), var(--color-surface);
    box-shadow: var(--shadow-panel);
  }

  .privacy-panel > span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .privacy-panel h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.5rem, 3vw, 2.3rem);
  }

  .privacy-panel p {
    max-width: 52rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .credential-collections {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .credential-group {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    border-top: 1px solid var(--color-line);
  }

  .credential-group__heading {
    display: grid;
    gap: var(--space-8);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .credential-group__heading > div:first-child {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .credential-group__heading > div:first-child > span {
    color: var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .credential-group h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
  }

  .credential-group__heading > div:last-child > p {
    max-width: 43rem;
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
  }

  .admission-note {
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    font-size: 0.9rem;
  }

  .credential-grid {
    display: grid;
    gap: var(--space-6);
  }

  .credential-card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 1rem 4rem color-mix(in srgb, var(--color-background) 55%, transparent);
  }

  .credential-card__preview {
    position: relative;
    display: grid;
    min-height: 14rem;
    overflow: hidden;
    place-items: center;
    border-bottom: 1px solid var(--color-line);
    background: #f7f8fb;
  }

  .credential-card__preview img {
    width: 100%;
    height: 100%;
    max-height: 21rem;
    object-fit: contain;
    filter: grayscale(0.18) saturate(0.82);
    transition:
      filter var(--transition-base),
      transform var(--transition-base);
  }

  .credential-card__preview--document {
    min-height: clamp(28rem, 70vw, 44rem);
    padding: var(--space-4);
  }

  .credential-card__preview--document img {
    max-height: 42rem;
  }

  .credential-card__preview:hover img {
    filter: grayscale(0) saturate(1);
    transform: scale(1.015);
  }

  .credential-card__preview > span {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 0.38rem 0.58rem;
    border: 1px solid rgba(142, 185, 255, 0.55);
    border-radius: 99rem;
    background: rgba(3, 7, 13, 0.84);
    color: var(--blue-100);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
  }

  .credential-card__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.35rem, 4vw, 2.2rem);
  }

  .credential-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .credential-card h3 {
    max-width: 23ch;
    margin: var(--space-6) 0 var(--space-3);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
  }

  .credential-card__body > p:not(.credential-card__privacy) {
    color: var(--color-text-muted);
  }

  .credential-card dl {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5, 1.25rem) 0 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-line);
  }

  .credential-card dl div {
    display: grid;
    grid-template-columns: minmax(7rem, 0.4fr) minmax(0, 0.6fr);
    gap: var(--space-3);
  }

  .credential-card dt {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .credential-card dd {
    margin: 0;
    font-weight: 650;
    text-align: right;
  }

  .credential-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5, 1.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .credential-card li {
    padding: 0.34rem 0.58rem;
    border: 1px solid var(--color-line);
    border-radius: 99rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .credential-card__privacy {
    margin: var(--space-5, 1.25rem) 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .credential-card__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-6);
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .credential-card__link:hover {
    color: var(--color-text);
  }

  .grades-panel {
    margin-top: var(--space-8);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .grades-panel__heading {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border-bottom: 1px solid var(--color-line);
  }

  .grades-panel h3 {
    margin: var(--space-3) 0 0;
    font-size: clamp(1.7rem, 3vw, 2.7rem);
  }

  .grades-panel__heading p {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  .grades-panel__context {
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    font-size: 0.85rem;
  }

  .grades-table-wrap {
    overflow-x: auto;
  }

  .grades-panel table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
  }

  .grades-panel th,
  .grades-panel td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-line);
    text-align: center;
  }

  .grades-panel thead th {
    background: color-mix(in srgb, var(--color-glow) 45%, transparent);
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .grades-panel th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 16rem;
    background: var(--color-surface-solid);
    text-align: left;
  }

  .grades-panel tbody th {
    color: var(--color-text-muted);
    font-size: 0.84rem;
    font-weight: 550;
  }

  .grades-panel td {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .grades-panel tbody tr:last-child th,
  .grades-panel tbody tr:last-child td {
    border-bottom: 0;
  }

  @media (min-width: 48rem) {
    .privacy-panel {
      grid-template-columns: minmax(8rem, 0.22fr) minmax(0, 0.78fr);
    }

    .credential-group__heading {
      grid-template-columns: minmax(11rem, 0.28fr) minmax(0, 0.72fr);
    }

    .credential-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .credential-group[data-credential-category='school'] .credential-grid {
      grid-template-columns: 1fr;
    }

    .grades-panel__heading {
      grid-template-columns: minmax(16rem, 0.42fr) minmax(0, 0.58fr);
    }
  }

  @media (min-width: 56rem) {
    .credentials-hero__grid {
      grid-template-columns: minmax(0, 1.12fr) minmax(22rem, 0.88fr);
      align-items: end;
    }

    .credential-group[data-credential-category='school'] .credential-card {
      grid-template-columns: minmax(22rem, 1fr) minmax(20rem, 0.82fr);
    }

    .credential-group[data-credential-category='school'] .credential-card__preview {
      border-right: 1px solid var(--color-line);
      border-bottom: 0;
    }
  }
</style>
