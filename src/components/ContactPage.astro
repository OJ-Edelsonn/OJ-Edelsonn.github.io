---
import type { Locale } from '../config/site';
import { SITE } from '../config/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy =
  locale === 'es'
    ? {
        eyebrow: 'Canal / oportunidades',
        title: 'Conversemos',
        intro:
          'Si buscas un perfil junior que conecte datos, procesos y sistemas, puedes escribirme directamente o preparar el mensaje desde este formulario.',
        availability:
          'Disponible para conversar sobre prácticas preprofesionales en Lima, modalidad híbrida, presencial o remota.',
        direct: 'Canales directos',
        form: 'Preparar correo',
        name: 'Nombre',
        email: 'Correo',
        subject: 'Asunto',
        message: 'Mensaje',
        send: 'Abrir aplicación de correo',
        note: 'Este sitio no envía ni almacena el formulario. Al continuar se abrirá tu aplicación de correo con el mensaje preparado; podrás revisarlo antes de enviarlo.',
        required: 'Revisa los campos obligatorios antes de continuar.',
        opening:
          'Preparando el correo. Verifica tu aplicación de correo para revisarlo y enviarlo.',
      }
    : {
        eyebrow: 'Channel / opportunities',
        title: 'Let’s talk',
        intro:
          'If you are looking for a junior profile connecting data, processes, and systems, you can write directly or prepare your message through this form.',
        availability:
          'Available to discuss pre-professional internships in Lima, in hybrid, on-site, or remote settings.',
        direct: 'Direct channels',
        form: 'Prepare email',
        name: 'Name',
        email: 'Email',
        subject: 'Subject',
        message: 'Message',
        send: 'Open email application',
        note: 'This site does not send or store the form. Continuing opens your email application with a prepared message so you can review it before sending.',
        required: 'Review the required fields before continuing.',
        opening: 'Preparing the email. Check your email application to review and send it.',
      };
---

<article class="contact-page">
  <header class="contact-hero">
    <div class="container contact-hero__grid">
      <div><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1></div>
      <div>
        <p>{copy.intro}</p><div class="availability">
          <span aria-hidden="true"></span>{copy.availability}
        </div>
      </div>
    </div>
  </header>

  <section class="contact-content">
    <div class="container contact-content__grid">
      <aside class="contact-channels">
        <p class="eyebrow">01 / {copy.direct}</p><h2>{copy.direct}</h2>
        <ul>
          <li><span>Email</span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>
            <span>LinkedIn</span><a href={SITE.linkedin} rel="me">edelson-anghuelo-orihuela-jara</a>
          </li>
          <li><span>GitHub</span><a href={SITE.github} rel="me">OJ-Edelsonn</a></li>
        </ul>
      </aside>

      <section class="contact-form-panel">
        <p class="eyebrow">02 / {copy.form}</p><h2>{copy.form}</h2>
        <form
          data-contact-form
          data-recipient={SITE.email}
          data-invalid={copy.required}
          data-opening={copy.opening}
          novalidate
        >
          <div class="field">
            <label for="contact-name">{copy.name}</label><input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              minlength="2"
            />
          </div>
          <div class="field">
            <label for="contact-email">{copy.email}</label><input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>
          <div class="field field--wide">
            <label for="contact-subject">{copy.subject}</label><input
              id="contact-subject"
              name="subject"
              type="text"
              required
              minlength="3"
            />
          </div>
          <div class="field field--wide">
            <label for="contact-message">{copy.message}</label><textarea
              id="contact-message"
              name="message"
              rows="7"
              required
              minlength="20"></textarea>
          </div>
          <div class="form-footer field--wide">
            <p>{copy.note}</p><button class="button button--primary" type="submit"
              >{copy.send}<span aria-hidden="true">↗</span></button
            >
          </div>
          <p class="form-status field--wide" data-form-status aria-live="polite"></p>
        </form>
      </section>
    </div>
  </section>
</article>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        if (status) {
          status.textContent = form.dataset.invalid ?? '';
          status.dataset.state = 'error';
        }
        return;
      }

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const sender = String(data.get('email') ?? '').trim();
      const subject = String(data.get('subject') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const recipient = form.dataset.recipient ?? '';
      const body = `${message}\n\n—\n${name}\n${sender}`;
      if (status) {
        status.textContent = form.dataset.opening ?? '';
        status.dataset.state = 'ready';
      }
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(`[Portafolio] ${subject}`)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>

<style>
  .contact-hero {
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  .contact-hero__grid {
    display: grid;
    gap: var(--space-8);
    align-items: end;
  }
  .contact-hero__grid > * {
    min-width: 0;
  }
  h1 {
    margin: 1rem 0 0;
    font-size: clamp(3.2rem, 10vw, 9rem);
  }
  .contact-hero__grid > div:last-child > p {
    max-width: 42rem;
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }
  .availability {
    display: flex;
    max-width: 40rem;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .availability span {
    width: 0.5rem;
    flex: 0 0 auto;
    margin-top: 0.35rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 1rem var(--color-accent);
  }
  .contact-content {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-top: 1px solid var(--color-line);
  }
  .contact-content__grid {
    display: grid;
    gap: var(--space-8);
  }
  .contact-channels,
  .contact-form-panel {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .contact-channels h2,
  .contact-form-panel h2 {
    margin: var(--space-4) 0 var(--space-8);
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .contact-channels ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact-channels li {
    display: grid;
    gap: 0.4rem;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  .contact-channels li span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .contact-channels a {
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .contact-channels a:hover {
    color: var(--color-accent-strong);
  }
  form {
    display: grid;
    gap: var(--space-4);
  }
  .field {
    display: grid;
    gap: 0.5rem;
  }
  label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  input,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    color: var(--color-text);
    padding: 0.85rem 0.95rem;
  }
  input {
    min-height: 3.1rem;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }
  .form-footer {
    display: grid;
    gap: var(--space-4);
    align-items: end;
  }
  .form-footer p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.84rem;
  }
  .form-footer button {
    width: fit-content;
    cursor: pointer;
  }
  .form-status {
    min-height: 1.5rem;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .form-status[data-state='error'] {
    color: var(--color-accent-strong);
  }
  @media (min-width: 52rem) {
    .contact-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    }
    .contact-content__grid {
      grid-template-columns: minmax(18rem, 0.7fr) minmax(0, 1.3fr);
      align-items: start;
    }
    form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .field--wide {
      grid-column: span 2;
    }
    .form-footer {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
